#!/bin/sh
# SPDX-License-Identifier: MIT
# Control the Philips 499P9H over DDC/CI (ddcutil). See NOTES.md for how the
# codes were found. Only what works on this monitor is here; the KVM switch
# has no known code, so it is not offered.
#
#   monitor status          PBP on/off
#   monitor doctor          print diagnostics (read-only), to paste into a bug report
#   monitor pbp on|off      turn PBP on / off
#   monitor swap            swap the left and right windows (PBP only)
#   monitor input <source>  input of the screen (PBP off) / left window (PBP on);
#                           sources: hdmi1 hdmi2 usbc (or dp1) dp (or dp2)
#   monitor left <source>   same as input, left window with PBP on
#   monitor layout <left> <right>   both windows (PBP on): hdmi1 hdmi2 dp usbc
set -u

# Which monitor to talk to: the EDID model name ddcutil shows in `ddcutil detect`.
# Override with MONITOR_MODEL=... if yours is reported differently.
MODEL="${MONITOR_MODEL:-PHL 499P9}"
command -v ddcutil >/dev/null 2>&1 || { echo "monitor: ddcutil is not installed" >&2; exit 1; }
ddc() { ddcutil --model "$MODEL" "$@"; }

die() { echo "monitor: $*" >&2; exit 1; }

# Last byte of the brief reply (ddcutil may print unrelated notices first),
# e.g. "VCP 60 SNC x11" -> "11".
getvcp_low() {
  ddc --brief getvcp "$1" 2>/dev/null | tail -1 | awk '{print $NF}' | sed 's/^x//'
}

# Fast read of E6 (PBP flag) for `status`, which the app polls often. It uses the
# I2C bus remembered from the last slow lookup: 0.25 s instead of ~1.6 s for
# the search by model name. Reads only: a stale bus number can at worst fail
# (then the slow lookup runs and the bus is remembered again) and can never
# change anything. Writes always find the monitor by model.
BUS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/monitor-ctl/bus"
read_e6() {
  if [ -r "$BUS_CACHE" ]; then
    out=$(ddcutil --bus "$(cat "$BUS_CACHE")" --brief getvcp E6 2>/dev/null | tail -1)
    case "$out" in
      "VCP E6 CNC "*) echo "$out" | awk '{print $NF}' | sed 's/^x//'; return 0 ;;
    esac
  fi
  v=$(getvcp_low E6)
  [ -n "$v" ] || return 1
  bus=$(ddcutil detect --brief 2>/dev/null | awk -v m="$MODEL" \
    '/I2C bus:/ {b=$NF} /Monitor:/ && index($0, m) {sub(".*i2c-", "", b); print b; exit}')
  if [ -n "$bus" ]; then
    mkdir -p "$(dirname "$BUS_CACHE")" && echo "$bus" > "$BUS_CACHE"
  fi
  echo "$v"
}

pbp_is_on() { [ "$(getvcp_low E6)" = "00" ]; }

# Wait up to ~15 s for PBP to reach the wanted state (E6: 00 = on, 01 = off).
wait_for_pbp() {
  i=0
  while [ $i -lt 8 ]; do
    [ "$(getvcp_low E6)" = "$1" ] && return 0
    sleep 2
    i=$((i + 1))
  done
  return 1
}

# hdmi1|hdmi2|dp|usbc -> VCP 60 value, or empty if it isn't one of them
input_value() {
  case "$1" in
    hdmi1) echo 0x11 ;; hdmi2) echo 0x12 ;; usbc | dp1) echo 0x0f ;; dp | dp2) echo 0x10 ;;
  esac
}


case "${1:-}" in
  status)
    v=$(read_e6) || die "no answer from the monitor (is DDC/CI on, cable connected?)"
    if [ "$v" = "00" ]; then echo "PBP: on"; else echo "PBP: off"; fi
    ;;
  pbp)
    case "${2:-}" in
      on)  want=00; value=512 ;;
      off) want=01; value=0 ;;
      *) die "usage: monitor pbp on|off" ;;
    esac
    # A5 is the window mode: 0 = single screen, 512 = PBP (it reads back as
    # 256 while PBP is on). A write to A5 is only accepted some of the time
    # right after a mode change, so try a few times.
    n=0
    while [ $n -lt 3 ]; do
      ddc --noverify setvcp A5 "$value" >/dev/null 2>&1
      wait_for_pbp "$want" && exit 0
      n=$((n + 1))
    done
    die "PBP did not turn $2 (the monitor ignored the command)"
    ;;
  doctor)
    # Everything needed to tell an app problem from a connection problem. Read-only.
    echo "== monitor doctor"
    echo "script:    $(readlink -f "$0")"
    echo "model:     $MODEL"
    echo "ddcutil:   $(ddcutil --version 2>&1 | head -1)"
    echo "session:   ${XDG_SESSION_TYPE:-?}, $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")"
    echo "bus cache: $(cat "$BUS_CACHE" 2>/dev/null || echo none)"
    gui="$(dirname "$(readlink -f "$0")")/monitor-gui.py"
    if [ -r "$gui" ]; then
      echo "app:       $gui ($(grep -c poll_seconds "$gui") poll_seconds refs: 0 = old version)"
    else
      echo "app:       not found next to the script"
    fi
    echo "-- ddcutil detect"
    ddcutil detect --brief 2>&1 | grep -E "I2C bus|Monitor|Invalid|Display [0-9]|No displays" | head -12 \
      | sed -E 's/^( *Monitor: +[^:]*:[^:]*):.*/\1:<serial hidden>/'
    echo "-- E6 (PBP flag; 00 = on, 01 = off), looked up by model"
    ddc --brief getvcp E6 2>&1 | tail -2
    echo "-- A5 (window mode), looked up by model"
    ddc getvcp A5 --verbose 2>&1 | grep -E "Raw value|error|Error" | head -2 | sed 's/.*Raw value: //'
    echo "-- monitor status"
    "$0" status 2>&1
    ;;
  swap)
    pbp_is_on || die "PBP is off, nothing to swap (turn PBP on in the monitor menu)"
    ddc --noverify setvcp F6 1 >/dev/null 2>&1 || die "swap failed"
    ;;
  input | left)
    v=$(input_value "${2:-}")
    [ -n "$v" ] || die "usage: monitor $1 hdmi1|hdmi2|dp|usbc"
    ddc setvcp 60 "$v" >/dev/null 2>&1 || die "could not set the input"
    ;;
  layout)
    # Only the left window has an input code (60), and reading it back is NOT
    # reliable (it has reported the wrong input). So set both windows
    # explicitly: put the right input on the left, swap the windows (the right
    # input is now on the right), then put the left input on the left.
    l=$(input_value "${2:-}"); r=$(input_value "${3:-}")
    [ -n "$l" ] && [ -n "$r" ] || die "usage: monitor layout <left> <right>  (hdmi1|hdmi2|dp|usbc)"
    pbp_is_on || die "PBP is off, there are no two windows (monitor pbp on)"
    ddc setvcp 60 "$r" >/dev/null 2>&1 || die "could not set the right input"
    sleep 2
    ddc --noverify setvcp F6 1 >/dev/null 2>&1 || die "swap failed"
    sleep 2
    ddc setvcp 60 "$l" >/dev/null 2>&1 || die "could not set the left input"
    ;;
  *)
    sed -n '7,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
