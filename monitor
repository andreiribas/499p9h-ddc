#!/bin/sh
# SPDX-License-Identifier: MIT
# Control the Philips 499P9H over DDC/CI (ddcutil). See NOTES.md for how the
# codes were found. Only what works on this monitor is here; the KVM switch
# has no known code, so it is not offered.
#
#   monitor status          PBP on/off
#   monitor doctor          print diagnostics (read-only), to paste into a bug report
#   monitor pbp on|off      turn PBP on / off
#   monitor pbp on <left>   turn PBP on and set the left window
#   monitor swap            swap the left and right windows (PBP only)
#   monitor input <source>  input of the screen (PBP off) / left window (PBP on);
#                           sources: hdmi1 hdmi2 usbc (or dp1) dp (or dp2)
#   monitor left <source>   same as input, left window with PBP on
#   monitor layout <left> <right>   EXPERIMENTAL, unreliable: both windows (PBP on).
#                           The right window is better set once in the monitor's
#                           menu: the monitor remembers it.
#   monitor picture         all picture settings, one "name value" per line
#   monitor get <setting>   show one setting; monitor set <setting> <value> changes it
#   monitor brightness [N|+N|-N]    show / set / adjust (also contrast sharpness volume)
#   monitor mute|preset|gamma|mode [value]   mute: on off; preset: srgb 5000k 6500k 7500k
#                           8200k 9300k 11500k user; gamma: 1.8 2.0 2.2 2.4 2.6;
#                           mode: standard productivity mixed movie games
#   monitor scaling noscale|aspect|stretch   how a smaller picture fills the screen
#   monitor osd on|off      show the monitor's menu or not (the buttons still work; `osd on` brings it back)
#   monitor language <name> english french german ... (see the README)
#   monitor gain-red|gain-green|gain-blue [N|+N|-N]   RGB gain, 0-100 (preset "user")
#   monitor profile list | show <name> | apply <name> | delete <name>
#   monitor profile save <name> [pbp on|off] [input|left <source>]   save the picture settings
#                           (and PBP / the input, when given) as a profile for `apply`
set -u

# Which monitor to talk to: the EDID model name ddcutil shows in `ddcutil detect`.
# Override with MONITOR_MODEL=... if yours is reported differently.
MODEL="${MONITOR_MODEL:-PHL 499P9}"
command -v ddcutil >/dev/null 2>&1 || { echo "monitor: ddcutil is not installed" >&2; exit 1; }
ddc() { ddcutil --model "$MODEL" "$@"; }

# Writes are fast (about 0.1 s instead of 3+ s): by default ddcutil first scans
# every display and probes the monitor, and the monitor is slow to answer those
# probes. So find the monitor's I2C bus from the kernel's list of connected
# displays (milliseconds; it must be a connected display whose EDID names this
# model, so a write can never go to another screen) and skip ddcutil's probing
# when this ddcutil supports that. Anything else falls back to the slow lookup.
FAST_OPTS=""
if ddcutil --help 2>&1 | grep -q -- "--skip-ddc-checks"; then FAST_OPTS="--skip-ddc-checks"; fi

find_bus() {
  for c in /sys/class/drm/card*-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
    grep -aq "$MODEL" "$c/edid" 2>/dev/null || continue
    b=$(basename "$(readlink -f "$c/ddc" 2>/dev/null)")
    case "$b" in i2c-*) echo "${b#i2c-}"; return 0 ;; esac
  done
  return 1
}

# ddc_set CODE VALUE [--noverify]
ddc_set() {
  if bus=$(find_bus); then
    # shellcheck disable=SC2086
    ddcutil --bus "$bus" $FAST_OPTS ${3:-} setvcp "$1" "$2" >/dev/null 2>&1 && return 0
    # the monitor can be busy for a moment right after a write: try once more
    # quickly before falling back to the slow lookup (3+ s)
    sleep 0.3
    ddcutil --bus "$bus" $FAST_OPTS ${3:-} setvcp "$1" "$2" >/dev/null 2>&1 && return 0
  fi
  ddc ${3:-} setvcp "$1" "$2" >/dev/null 2>&1
}

die() { echo "monitor: $*" >&2; exit 1; }

# MONITOR_TRACE=1 prints the time of each step to stderr (to see where a command
# spends its time).
T0=$(date +%s.%N)
trace() { [ -z "${MONITOR_TRACE:-}" ] || printf '%6.2fs  %s\n' "$(echo "$(date +%s.%N) - $T0" | bc)" "$*" >&2; }

# Shown when a command fails because the monitor does not answer. A computer can
# only control the monitor while its own input is the one showing: on any other
# input the monitor stops answering that computer's cable altogether.
NO_LINK="the monitor is not answering this computer. It is probably showing another input. Switch it back from the computer it is showing, or with the monitor's buttons"

# Last byte of the brief reply (ddcutil may print unrelated notices first),
# e.g. "VCP 60 SNC x11" -> "11".
getvcp_low() {
  ddc --brief getvcp "$1" 2>/dev/null | tail -1 | awk '{print $NF}' | sed 's/^x//'
}

# PBP state comes from A5 (window mode): 0 = one full screen, anything else =
# PBP (it reads 256 while PBP is on). E6 was used before, but it answered
# differently depending on which laptop asked and over which cable (it said "on"
# on a laptop connected by USB-C while the screen was a single picture), so it
# is not used any more.
a5_value() { # reads `getvcp A5 --verbose` on stdin, prints the current value as a number
  sed -n 's/.*cur_val= *\([0-9][0-9]*\).*/\1/p' | head -1
}

# Fast read of A5 for `status`, which the app polls often. It uses the I2C bus
# remembered from the last slow lookup: about 0.25 s instead of ~1.6 s for the
# search by model name. Reads only: a stale bus number can at worst fail (then
# the slow lookup runs and the bus is remembered again) and can never change
# anything. Writes always find the monitor by model.
BUS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/monitor-ctl/bus"
read_pbp() {
  if [ -r "$BUS_CACHE" ]; then
    v=$(ddcutil --bus "$(cat "$BUS_CACHE")" getvcp A5 --verbose 2>/dev/null | a5_value)
    if [ -n "$v" ]; then echo "$v"; return 0; fi
  fi
  v=$(ddc getvcp A5 --verbose 2>/dev/null | a5_value)
  [ -n "$v" ] || return 1
  bus=$(ddcutil detect --brief 2>/dev/null | awk -v m="$MODEL" \
    '/I2C bus:/ {b=$NF} /Monitor:/ && index($0, m) {sub(".*i2c-", "", b); print b; exit}')
  if [ -n "$bus" ]; then
    mkdir -p "$(dirname "$BUS_CACHE")" && echo "$bus" > "$BUS_CACHE"
  fi
  echo "$v"
}

# Current A5 value, as fast as possible: the bus from sysfs (or the remembered one)
# with ddcutil's probing skipped, else the slow lookup by model.
a5_now() {
  bus=$(find_bus) || bus=$(cat "$BUS_CACHE" 2>/dev/null) || bus=""
  if [ -n "$bus" ]; then
    # shellcheck disable=SC2086
    v=$(ddcutil --bus "$bus" $FAST_OPTS getvcp A5 --verbose 2>/dev/null | a5_value)
    if [ -n "$v" ]; then echo "$v"; return 0; fi
  fi
  ddc getvcp A5 --verbose 2>/dev/null | a5_value
}

pbp_is_on() {
  v=$(a5_now)
  [ -n "$v" ] && [ "$v" != 0 ]
}

# Wait for PBP to reach the wanted state ("on" or "off"), for up to $2 seconds
# (default 10). The monitor needs a few seconds to re-sync after the change and
# asking it constantly during that time seems to slow it down, so leave it alone
# for the first second, then check every 0.5 s.
wait_for_pbp() {
  sleep "${MONITOR_PBP_QUIET:-1}"
  i=0
  max=$(( ${2:-10} * 2 ))
  while [ $i -lt $max ]; do
    v=$(a5_now)
    if [ "$1" = on ] && [ -n "$v" ] && [ "$v" != 0 ]; then return 0; fi
    if [ "$1" = off ] && [ "$v" = 0 ]; then return 0; fi
    sleep 0.5
    i=$((i + 1))
  done
  return 1
}

# hdmi1|hdmi2|usbc|dp -> VCP 60 value, or empty if it isn't one of them. The
# names follow the monitor's own menu, which numbers the HDMI ports the other
# way round from DDC: menu "HDMI 1" is 0x12 and menu "HDMI 2" is 0x11 (a laptop
# on the port the menu calls HDMI 2 shows up when VCP 60 is set to 0x11). USB-C
# is 0x0f and the DisplayPort connector 0x10.
input_value() {
  case "$1" in
    hdmi1) echo 0x12 ;; hdmi2) echo 0x11 ;; usbc | dp1) echo 0x0f ;; dp | dp2) echo 0x10 ;;
  esac
}

# ---- picture settings -----------------------------------------------------
# Standard MCCS codes, listed in the monitor's capabilities (snapshots/capabilities.txt).
# Ranges: brightness, contrast, volume, RGB gain 0-100, sharpness 0-10. The gain only
# shows when the colour preset is "user". Choices are named.
SETTINGS="brightness contrast sharpness volume mute preset gamma mode scaling osd language gain-red gain-green gain-blue"
setting_code() {
  case "$1" in
    brightness) echo 10 ;; contrast) echo 12 ;; sharpness) echo 87 ;; volume) echo 62 ;;
    mute) echo 8D ;; preset) echo 14 ;; gamma) echo 72 ;; mode) echo DC ;;
    scaling) echo 86 ;; osd) echo CA ;; language) echo CC ;;
    gain-red) echo 16 ;; gain-green) echo 18 ;; gain-blue) echo 1A ;;
  esac
}
range_max() { case "$1" in sharpness) echo 10 ;; *) echo 100 ;; esac; }
# setting, name, VCP value (decimal). Gamma values are the monitor's presets
# (0x50 .. 0xa0); mute is 1 = muted, 2 = not muted.
CHOICES="mute on 1
mute off 2
preset srgb 1
preset 5000k 4
preset 6500k 5
preset 7500k 6
preset 8200k 7
preset 9300k 8
preset 11500k 10
preset user 11
gamma 1.8 80
gamma 2.0 100
gamma 2.2 120
gamma 2.4 140
gamma 2.6 160
mode standard 0
mode productivity 1
mode mixed 2
mode movie 3
mode games 5
scaling noscale 1
scaling aspect 2
scaling stretch 8
osd off 1
osd on 2
language tchinese 1
language english 2
language french 3
language german 4
language italian 5
language japanese 6
language korean 7
language portuguese 8
language russian 9
language spanish 10
language swedish 11
language turkish 12
language schinese 13
language ptbr 14
language czech 18
language dutch 20
language finnish 22
language greek 23
language hungarian 26
language polish 30
language ukrainian 36"
choice_num() { echo "$CHOICES" | awk -v f="$1" -v n="$2" '$1 == f && $2 == n {print $3}'; }
choice_name() { echo "$CHOICES" | awk -v f="$1" -v n="$2" '$1 == f && $3 == n {print $2}'; }

# vcp_query CODE... -> the "VCP ..." reply lines (several codes in one call: about
# 0.4 s for all eight settings)
vcp_query() {
  out=""
  if bus=$(find_bus); then
    # shellcheck disable=SC2086
    out=$(ddcutil --bus "$bus" $FAST_OPTS --brief getvcp "$@" 2>/dev/null)
  fi
  [ -n "$out" ] || out=$(ddc --brief getvcp "$@" 2>/dev/null)
  printf '%s\n' "$out" | grep '^VCP ' || return 1
}

# setting_show SETTING "VCP line" -> "<value> <max>" for ranges, the name for choices
setting_show() {
  s=$1; shift
  case "$3" in   # $1 VCP, $2 code, $3 kind: C = range (cur max), SNC / CNC = choice
    C) cur=$4; max=$5 ;;
    SNC) cur=$((0x${4#x})); max= ;;
    CNC) cur=$((0x${7#x})); max= ;;
    *) echo "n/a"; return 1 ;;
  esac
  case "$s" in
    brightness|contrast|sharpness|volume|gain-*) echo "$cur $max" ;;
    *) n=$(choice_name "$s" "$cur"); echo "${n:-$cur}" ;;
  esac
}

get_setting() {
  code=$(setting_code "$1"); [ -n "$code" ] || die "unknown setting '$1' (one of: $SETTINGS)"
  line=$(vcp_query "$code") || die "$NO_LINK"
  # shellcheck disable=SC2086
  v=$(setting_show "$1" $line) || die "the monitor does not report $1"
  echo "${v% *}" | awk '{print $1}'
}

set_setting() {
  code=$(setting_code "$1"); [ -n "$code" ] || die "unknown setting '$1' (one of: $SETTINGS)"
  val=${2:-}; [ -n "$val" ] || die "usage: monitor set $1 <value>"
  case "$1" in
    brightness|contrast|sharpness|volume|gain-*)
      max=$(range_max "$1")
      case "$val" in
        [+-][0-9]*)   # relative: needs the current value
          d=${val#[+-]}
          case "$d" in *[!0-9]*) die "not a number: $val" ;; esac
          cur=$(get_setting "$1") || exit 1
          if [ "${val%"$d"}" = + ]; then n=$((cur + d)); else n=$((cur - d)); fi
          [ "$n" -le "$max" ] || n=$max
          [ "$n" -ge 0 ] || n=0 ;;
        *[!0-9]* | "") die "$1 takes a number 0-$max, or +N / -N" ;;
        *) n=$val; [ "$n" -le "$max" ] || die "$1 is 0-$max" ;;
      esac ;;
    *)
      val=$(echo "$val" | tr 'A-Z' 'a-z')
      n=$(choice_num "$1" "$val")
      [ -n "$n" ] || die "$1: '$val' is not one of: $(echo "$CHOICES" | awk -v f="$1" '$1 == f {printf "%s ", $2}')" ;;
  esac
  ddc_set "$code" "$n" || die "could not set $1: $NO_LINK"
  case "$1" in
    brightness|contrast|sharpness|volume|gain-*) echo "$1 $n" ;;
    *) echo "$1 $val" ;;
  esac
}

# picture: every setting in one read, "name value" per line (ranges: "name cur max")
show_picture() {
  codes=""; for s in $SETTINGS; do codes="$codes $(setting_code "$s")"; done
  # shellcheck disable=SC2086
  lines=$(vcp_query $codes) || die "$NO_LINK"
  for s in $SETTINGS; do
    code=$(setting_code "$s")
    line=$(echo "$lines" | awk -v c="$code" '$2 == c {print; exit}')
    if [ -n "$line" ]; then
      # shellcheck disable=SC2086
      echo "$s $(setting_show "$s" $line)"
    else
      echo "$s n/a"
    fi
  done
}

# ---- profiles -------------------------------------------------------------
# A profile is a text file of "key value" lines in PROFILE_DIR: any picture setting
# (see SETTINGS), plus pbp (on|off) and input / left (a source name). Saving takes the
# picture settings from the monitor; PBP and inputs can't be read back reliably, so
# they are only saved when given on the command line.
PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/monitor-ctl/profiles"
# The order matters: PBP and inputs first (the monitor re-syncs for a few seconds),
# then gain before preset (writing a gain makes the monitor switch to "user").
PROFILE_ORDER="pbp input left gain-red gain-green gain-blue preset gamma mode brightness contrast sharpness volume mute"

profile_file() {
  case "$1" in "" | *[!A-Za-z0-9_-]*) die "a profile name uses letters, digits, - and _" ;; esac
  echo "$PROFILE_DIR/$1"
}
profile_key_ok() { case " $PROFILE_ORDER " in *" $1 "*) return 0 ;; esac; return 1; }
profile_value() { awk -v k="$2" '$1 == k {print $2; exit}' "$1"; }

save_profile() {
  name=$1; shift
  f=$(profile_file "$name") || exit 1
  extra=""
  while [ $# -gt 0 ]; do   # key value pairs: pbp on|off, input|left <source>
    [ $# -ge 2 ] || die "usage: monitor profile save <name> [pbp on|off] [input|left <source>]"
    case "$1" in
      pbp) case "$2" in on | off) ;; *) die "pbp takes on or off" ;; esac ;;
      input | left) [ -n "$(input_value "$2")" ] || die "$1 takes hdmi1|hdmi2|usbc|dp" ;;
      *) die "only pbp, input and left can be added to a profile by hand" ;;
    esac
    extra="$extra$1 $2
"
    shift 2
  done
  pic=$(show_picture) || exit 1
  mkdir -p "$PROFILE_DIR" || die "cannot create $PROFILE_DIR"
  tmp=$(mktemp "$PROFILE_DIR/.tmp.XXXXXX") || die "cannot write in $PROFILE_DIR"
  {
    printf '%s' "$extra"
    # the gain is only meaningful with the "user" preset
    echo "$pic" | awk '$1 == "preset" && $2 == "user" {u = 1} {l[NR] = $0}
      END {for (i = 1; i <= NR; i++) {split(l[i], a, " ");
        if (a[2] != "n/a" && (a[1] !~ /^gain-/ || u)) print a[1], a[2]}}'
  } > "$tmp" && mv "$tmp" "$f" || { rm -f "$tmp"; die "could not save the profile"; }
  echo "saved $name"
}

apply_profile() {
  f=$(profile_file "$1") || exit 1
  [ -r "$f" ] || die "no profile '$1' (monitor profile list)"
  # check every line first, so a bad profile is refused before anything changes
  while read -r k v _; do
    case "$k" in "" | \#*) continue ;; esac
    profile_key_ok "$k" || die "profile '$1': unknown setting '$k'"
    [ -n "$v" ] || die "profile '$1': '$k' has no value"
  done < "$f"
  failed=0
  for k in $PROFILE_ORDER; do
    v=$(profile_value "$f" "$k"); [ -n "$v" ] || continue
    case "$k" in
      pbp)
        cur=$(read_pbp) || die "$NO_LINK"
        if [ "$v" = on ] && [ "$cur" = 0 ]; then "$0" pbp on || failed=1
        elif [ "$v" = off ] && [ "$cur" != 0 ]; then "$0" pbp off || failed=1
        fi ;;
      input | left) "$0" input "$v" || failed=1 ;;
      *) "$0" set "$k" "$v" > /dev/null || failed=1 ;;
    esac
  done
  [ $failed = 0 ] || die "profile '$1': some settings could not be applied"
  echo "applied $1"
}

# Pause between the steps of a layout change: the monitor must have taken the
# previous step before the next one. MONITOR_LAYOUT_PAUSE overrides it.
LAYOUT_PAUSE="${MONITOR_LAYOUT_PAUSE:-1}"

# set_layout LEFT RIGHT [nocheck] (names). Only the left window has an input code (60), and
# reading it back is NOT reliable (it has reported the wrong input). So set both
# windows explicitly: put the right input on the left, swap the windows (the
# right input is now on the right), then put the left input on the left.
set_layout() {
  l=$(input_value "$1"); r=$(input_value "$2")
  [ -n "$l" ] && [ -n "$r" ] || die "usage: monitor layout <left> <right>  (hdmi1|hdmi2|usbc|dp)"
  trace "layout: start"
  if [ "${3:-}" != nocheck ]; then
    v=$(read_pbp) || die "$NO_LINK"
    [ "$v" != 0 ] || die "PBP is off, there are no two windows (monitor pbp on)"
    trace "layout: PBP state read"
  fi
  ddc_set 60 "$r" || die "could not set the right input: $NO_LINK"
  trace "layout: right input put on the left"
  sleep "$LAYOUT_PAUSE"
  ddc_set F6 1 --noverify || die "swap failed: $NO_LINK"
  trace "layout: swapped"
  sleep "$LAYOUT_PAUSE"
  ddc_set 60 "$l" || die "could not set the left input: $NO_LINK"
  trace "layout: left input set"
}

case "${1:-}" in
  status)
    v=$(read_pbp) || die "$NO_LINK (also check that DDC/CI is on in the monitor menu)"
    if [ "$v" != 0 ]; then echo "PBP: on"; else echo "PBP: off"; fi
    ;;
  pbp)
    case "${2:-}" in
      on)  want=on; value=512 ;;
      off) want=off; value=0 ;;
      *) die "usage: monitor pbp on|off  |  monitor pbp on <left>" ;;
    esac
    left_val=""
    if [ "$want" = on ] && [ -n "${3:-}" ]; then   # check the argument before touching the monitor
      left_val=$(input_value "$3"); [ -n "$left_val" ] || die "usage: monitor pbp on <left>  (hdmi1|hdmi2|usbc|dp)"
    fi
    # A5 is the window mode: 0 = single screen, 512 = PBP (it reads back as 256
    # while PBP is on). The monitor sometimes ignores a write that comes right
    # after another change, so if the state hasn't changed after 5 s, write again.
    n=0
    done_=""
    while [ $n -lt 3 ]; do
      trace "pbp $2: write A5 = $value"
      ddc_set A5 "$value" --noverify
      trace "pbp $2: written, waiting for the monitor"
      if wait_for_pbp "$want" 5; then done_=1; break; fi
      n=$((n + 1))
    done
    [ -n "$done_" ] || die "PBP did not turn $2 (the monitor ignored the command)"
    trace "pbp $2: monitor confirmed"
    # Turning PBP on only splits the screen. The right half shows the input set in
    # the monitor's own menu, which the monitor remembers (checked: it comes back
    # after PBP off and on). With <left> given, also set the left window.
    if [ -n "$left_val" ]; then
      ddc_set 60 "$left_val" || die "could not set the left input: $NO_LINK"
      trace "pbp on: left window set"
    fi
    ;;
  doctor)
    # Everything needed to tell an app problem from a connection problem. Read-only.
    echo "== monitor doctor"
    echo "script:    $(readlink -f "$0")"
    echo "model:     $MODEL"
    echo "ddcutil:   $(ddcutil --version 2>&1 | head -1)"
    echo "session:   ${XDG_SESSION_TYPE:-?}, $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")"
    echo "bus cache: $(cat "$BUS_CACHE" 2>/dev/null || echo none)"
    echo "fast path: bus from sysfs = $(find_bus || echo 'not found (monitor not on a connected port of this computer)'); ddcutil probing skipped = ${FAST_OPTS:-no (this ddcutil has no --skip-ddc-checks)}"
    gui="$(dirname "$(readlink -f "$0")")/monitor-gui.py"
    if [ -r "$gui" ]; then
      echo "app:       $gui ($(grep -c poll_seconds "$gui") poll_seconds refs: 0 = old version)"
    else
      echo "app:       not found next to the script"
    fi
    echo "-- ddcutil detect"
    ddcutil detect --brief 2>&1 | grep -E "I2C bus|Monitor|Invalid|Display [0-9]|No displays" | head -12 \
      | sed -E 's/^( *Monitor: +[^:]*:[^:]*):.*/\1:<serial hidden>/'
    echo "-- E6 (no longer used: it differs between laptops/cables), looked up by model"
    ddc --brief getvcp E6 2>&1 | tail -2
    echo "-- A5 (window mode: 0 = one screen, 256 = PBP), looked up by model"
    ddc getvcp A5 --verbose 2>&1 | grep -E "Raw value|error|Error" | head -2 | sed 's/.*Raw value: //'
    echo "-- monitor status"
    "$0" status 2>&1
    ;;
  swap)
    v=$(read_pbp) || die "$NO_LINK"
    [ "$v" != 0 ] || die "PBP is off, nothing to swap (turn PBP on in the monitor menu)"
    ddc_set F6 1 --noverify || die "swap failed: $NO_LINK"
    ;;
  input | left)
    v=$(input_value "${2:-}")
    [ -n "$v" ] || die "usage: monitor $1 hdmi1|hdmi2|dp|usbc"
    ddc_set 60 "$v" || die "could not set the input: $NO_LINK"
    ;;
  layout)
    set_layout "${2:-}" "${3:-}"
    ;;
  picture)
    show_picture
    ;;
  get)
    get_setting "${2:-}"
    ;;
  set)
    set_setting "${2:-}" "${3:-}"
    ;;
  brightness | contrast | sharpness | volume | mute | preset | gamma | mode | scaling | osd | language | gain-red | gain-green | gain-blue)
    if [ -z "${2:-}" ]; then get_setting "$1"; else set_setting "$1" "$2"; fi
    ;;
  profile)
    case "${2:-}" in
      list) ls "$PROFILE_DIR" 2>/dev/null | grep -E '^[A-Za-z0-9_-]+$' || true ;;
      show) f=$(profile_file "${3:-}") || exit 1; [ -r "$f" ] || die "no profile '${3:-}'"; cat "$f" ;;
      save) [ -n "${3:-}" ] || die "usage: monitor profile save <name> ..."; n=$3; shift 3; save_profile "$n" "$@" ;;
      apply) apply_profile "${3:-}" ;;
      delete) f=$(profile_file "${3:-}") || exit 1; [ -r "$f" ] || die "no profile '${3:-}'"; rm -f "$f" && echo "deleted $3" ;;
      *) die "usage: monitor profile list | show <name> | apply <name> | delete <name> | save <name> [pbp on|off] [input|left <source>]" ;;
    esac
    ;;
  *)
    sed -n '7,30p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
